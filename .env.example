TOKEN=""
CLIENT_ID=""
GUILD_ID=""
SHOW_DEBUG="false"

# Queue/Redis (BullMQ)
REDIS_URL="redis://127.0.0.1:6379"
REDIS_KEY_PREFIX="osu-preview-botinator"
REDIS_CONNECT_TIMEOUT_MS="5000"
REDIS_MAX_RETRIES="10"
REDIS_RETRY_DELAY_MS="500"
REDIS_PREFLIGHT_TIMEOUT_MS="4000"
REDIS_PREFLIGHT_RETRIES="2"
REDIS_PREFLIGHT_RETRY_DELAY_MS="1000"
QUEUE_NAME="osu-preview-renders"
WORKER_CONCURRENCY="1"
QUEUE_MAX_BACKLOG="150"
QUEUE_ESTIMATED_JOB_SEC="180"
QUEUE_TELEMETRY_INTERVAL_SEC="30"
JOB_ATTEMPTS="3"
JOB_BACKOFF_MS="5000"
REQUEST_COOLDOWN_SEC="3"
QUEUE_NOTICE_COOLDOWN_SEC="30"

# Render behavior
FFMPEG_THREADS="2"
RENDER_CACHE_TTL_SEC="2592000"
DELIVERY_DEDUP_WINDOW_SEC="300"
RENDERER_VERSION="v1"
# Lower single-job latency consistency profile
GC_MODE="aggressive"
GC_EVERY_N_JOBS="1"
GC_RSS_THRESHOLD_MB="1200"
WORKER_MAX_JOBS_BEFORE_RESTART="2"
WORKER_RESTART_RSS_MB="1800"
WORKER_REDIS_ERROR_BUDGET="5"
WORKER_REDIS_ERROR_WINDOW_MS="15000"
WORKER_BEATMAP_CACHE_SIZE="0"

# Asset fetching (audio + cover)
AUDIO_HEADER_TIMEOUT_MS="8000"
AUDIO_TOTAL_TIMEOUT_MS="45000"
AUDIO_STALL_TIMEOUT_MS="8000"
AUDIO_HEDGE_DELAY_MS="2000"
MIRROR_COOLDOWN_SEC="300"
COVER_FETCH_TIMEOUT_MS="3000"

# Cloudflare R2 Configuration
CLOUD_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUD_ACCESKEY="<your-r2-access-key-id>"
CLOUD_SECRETKEY="<your-r2-secret-access-key>"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"
R2_BUCKET="your-bucket-name"
